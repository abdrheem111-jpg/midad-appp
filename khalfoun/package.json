{
  "name": "khalfoun3",
  "productName": "خلفون ٣",
  "version": "3.0.0",
  "description": "خلفون ٣: مساعد كرتوني عُماني يعيش على سطح المكتب، يسمع الأوامر الصوتية وينفذها ويتفاعل بالمشاعر.",
  "type": "module",
  "main": "src/main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:ui": "node tools/ui-check.mjs",
    "smoke": "node tools/smoke.mjs",
    "preview": "node tools/serve.mjs",
    "icon": "node tools/make-icon.mjs",
    "check": "npm test && npm run smoke",
    "dist:win": "electron-builder --win nsis --publish never",
    "check:windows": "node tools/windows-check.mjs"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Khalfoun",
  "build": {
    "appId": "om.khalfoun.desktop3",
    "productName": "Khalfoun3",
    "executableName": "Khalfoun3",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*{,/**/*}",
      "!node_modules/onnxruntime-web/{lib,docs}{,/**/*}",
      "!node_modules/onnxruntime-web/dist/**/*",
      "node_modules/onnxruntime-web/dist/ort.wasm.min.mjs",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.mjs",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm",
      "!node_modules/pyodide/*.map",
      "!node_modules/pyodide/console.html",
      "!node_modules/pyodide/*.d.ts"
    ],
    "extraMetadata": {
      "main": "src/main/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-256.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "خلفون ٣",
      "artifactName": "Khalfoun3-Setup-${version}.exe",
      "installerLanguages": [
        "ar_SA",
        "en_US"
      ],
      "language": "1025"
    },
    "extraResources": [
      {
        "from": "..",
        "to": "midad",
        "filter": [
          "index.html",
          "manifest.webmanifest",
          "js/**/*",
          "css/**/*",
          "assets/**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/pyodide/**/*",
      "assets/math/**/*",
      "src/main/math/**/*"
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.330",
    "@anthropic-ai/sdk": "^1.12.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "docx": "^9.16.0",
    "jszip": "^3.10.1",
    "microsoft-cognitiveservices-speech-sdk": "1.53.0",
    "onnxruntime-web": "1.20.1",
    "pdf-lib": "1.17.1",
    "pptxgenjs": "^4.0.1",
    "pyodide": "0.27.7",
    "qrcode": "^1.5.4",
    "selfsigned": "^2.4.1",
    "zod": "^4.6.7"
  }
}
